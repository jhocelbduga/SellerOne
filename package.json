{
  "name": "sellerone",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @sellerone/inventory-service && npm run test --workspace @sellerone/platform-service",
    "dev:platform": "npm run dev --workspace @sellerone/platform-service",
    "dev:web": "npm run dev --workspace @sellerone/web",
    "start:platform": "npm run start --workspace @sellerone/platform-service",
    "start:web": "npm run build --workspace @sellerone/web && npm run start:platform",
    "start:inventory": "npm run start --workspace @sellerone/inventory-service",
    "start:orders": "npm run start --workspace @sellerone/orders-service",
    "start:customers": "npm run start --workspace @sellerone/customers-service",
    "start:accounting": "npm run start --workspace @sellerone/accounting-service"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.0"
  }
}
